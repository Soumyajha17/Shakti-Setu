<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#F3E5F5"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- HEADER -->
        <LinearLayout
            android:orientation="vertical"
            android:background="#6A1B9A"
            android:padding="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:text="My Bookings"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:text="Jobs booked by clients"
                android:textSize="13sp"
                android:textColor="#DDDDDD"
                android:layout_marginTop="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- BOOKINGS LIST -->
        <LinearLayout
            android:id="@+id/container"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- SAMPLE CARD (WILL BE DUPLICATED IN JAVA) -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                xmlns:app="http://schemas.android.com/apk/res-auto">

                <LinearLayout
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!-- Service -->
                    <TextView
                        android:id="@+id/tvService"
                        android:text="Cleaning Service"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#000000"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <!-- Client -->
                    <TextView
                        android:id="@+id/tvClient"
                        android:text="Client: Priya"
                        android:layout_marginTop="5dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <!-- Date -->
                    <TextView
                        android:id="@+id/tvDate"
                        android:text="Date: 10/04/2026"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <!-- Time -->
                    <TextView
                        android:id="@+id/tvTime"
                        android:text="Time: 6:00 PM"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <!-- Amount -->
                    <TextView
                        android:id="@+id/tvAmount"
                        android:text="Amount: ₹500"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <!-- Status -->
                    <TextView
                        android:id="@+id/tvStatus"
                        android:text="Status: Pending"
                        android:textColor="#BF8F00"
                        android:textStyle="bold"
                        android:layout_marginTop="5dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <!-- 🔥 APPLY BUTTON -->
                    <Button
                        android:id="@+id/btnApply"
                        android:text="Apply"
                        android:layout_marginTop="10dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </LinearLayout>

</ScrollView>