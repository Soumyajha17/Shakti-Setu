<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Header -->
        <LinearLayout
            android:background="@color/primary"
            android:padding="24dp"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/titleText"
                android:text="Job Title"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- Info Card -->
        <androidx.cardview.widget.CardView
            android:layout_margin="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="5dp"
            app:cardBackgroundColor="@color/white"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:orientation="vertical"
                android:padding="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Hours Row -->
                <LinearLayout android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginBottom="14dp"
                    android:layout_width="match_parent" android:layout_height="wrap_content">
                    <TextView android:text="⏰ " android:textSize="18sp"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView
                        android:id="@+id/hoursText"
                        android:textSize="16sp"
                        android:textColor="@color/text_primary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <View android:background="@color/divider" android:layout_marginBottom="14dp"
                    android:layout_width="match_parent" android:layout_height="1dp"/>

                <!-- Location Row -->
                <LinearLayout android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginBottom="14dp"
                    android:layout_width="match_parent" android:layout_height="wrap_content">
                    <TextView android:text="📍 " android:textSize="18sp"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView
                        android:id="@+id/locationText"
                        android:textSize="16sp"
                        android:textColor="@color/text_primary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <View android:background="@color/divider" android:layout_marginBottom="14dp"
                    android:layout_width="match_parent" android:layout_height="1dp"/>

                <!-- Payment Info -->
                <LinearLayout android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginBottom="14dp"
                    android:layout_width="match_parent" android:layout_height="wrap_content">
                    <TextView android:text="💼 " android:textSize="18sp"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView
                        android:id="@+id/paymentText"
                        android:textSize="16sp"
                        android:textColor="@color/text_primary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <View android:background="@color/divider" android:layout_marginBottom="14dp"
                    android:layout_width="match_parent" android:layout_height="1dp"/>

                <!-- Salary Tag -->
                <LinearLayout
                    android:background="@color/success_light"
                    android:padding="12dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView android:text="💰 " android:textSize="18sp"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView
                        android:id="@+id/salaryText"
                        android:text="Salary: ₹500/day"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/success"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <!-- Payment Status Tag -->
                <LinearLayout
                    android:background="@color/error_light"
                    android:padding="12dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView android:text="🔔 " android:textSize="18sp"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView
                        android:id="@+id/paymentStatusText"
                        android:text="Payment Status: Pending"
                        android:textSize="15sp"
                        android:textColor="@color/error"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Apply Button -->
        <Button
            android:id="@+id/applyBtn"
            android:text="Apply Now"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/button_primary_bg"
            android:textColor="@color/white"
            android:padding="16dp"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="24dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</ScrollView>
