<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="28dp"
    android:background="@color/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView android:text="⭐" android:textSize="52sp" android:gravity="center"
        android:layout_marginBottom="12dp"
        android:layout_width="wrap_content" android:layout_height="wrap_content"/>

    <TextView android:text="Rate the Service"
        android:textSize="22sp" android:textStyle="bold" android:textColor="@color/primary"
        android:layout_marginBottom="4dp"
        android:layout_width="wrap_content" android:layout_height="wrap_content"/>

    <TextView
        android:id="@+id/workerRatingLabel"
        android:text=""
        android:textSize="15sp" android:textColor="@color/text_secondary"
        android:layout_marginBottom="8dp"
        android:layout_width="wrap_content" android:layout_height="wrap_content"/>

    <TextView android:text="How was your experience?"
        android:textSize="14sp" android:textColor="@color/text_secondary"
        android:layout_marginBottom="24dp"
        android:layout_width="wrap_content" android:layout_height="wrap_content"/>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent" android:layout_height="wrap_content"
        app:cardCornerRadius="20dp" app:cardElevation="6dp"
        app:cardBackgroundColor="@color/white">
        <LinearLayout android:orientation="vertical" android:padding="28dp" android:gravity="center"
            android:layout_width="match_parent" android:layout_height="wrap_content">
            <RatingBar
                android:id="@+id/ratingBar"
                android:numStars="5"
                android:stepSize="1"
                android:progressTint="@color/warning"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView android:text="Tap a star to rate"
                android:textSize="13sp" android:textColor="@color/text_secondary"
                android:layout_marginTop="12dp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <Button
        android:id="@+id/submitRatingBtn"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Submit Rating"
        android:background="@drawable/button_primary_bg"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:layout_marginTop="24dp"/>

</LinearLayout>
